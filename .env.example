NODE_ENV=development
APP_NAME=Inventory Management System
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
PORT=4000
TRUST_PROXY=0

MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/ims?replicaSet=rs0
MONGODB_DB_NAME=ims
REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=ims.sid
SESSION_SECRET=change-me-to-a-random-64-char-value-before-first-run-xxxxxxxxxx
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CSRF_SECRET=change-me-to-a-random-64-char-value-before-first-run-xxxxxxxxxxx

PASSWORD_PEPPER=change-me-to-a-random-64-char-value-before-first-run-xxxxxxx
MFA_ENCRYPTION_KEY=change-me-to-a-random-64-char-value-before-first-run-xxxxxx

# Read only by `pnpm db:seed` (apps/api/src/seed.ts), never by the running API.
# Local dev convenience only -- if SEED_ADMIN_PASSWORD is unset, the seed
# script generates a random password and prints it once to the console
# instead (it is not stored anywhere, so if you miss it, use the
# forgot-password flow to issue yourself a new one). Do not set a real
# password here in a committed/shared env file.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ims-private
OBJECT_STORAGE_ACCESS_KEY=localminio
OBJECT_STORAGE_SECRET_KEY=localminiosecret

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=inventory@example.test

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DEFAULT_EXPIRY_WARNING_DAYS=90
