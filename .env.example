NODE_ENV=development
APP_NAME=Inventory Management System
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
PORT=4000
TRUST_PROXY=0

# Port 27018, not the Mongo default 27017 -- a native, non-Docker MongoDB
# service commonly already owns 27017 on a dev machine. See docs/LOCAL_SERVICES.md.
MONGODB_URI=mongodb://localhost:27018/ims?replicaSet=rs0
MONGODB_DB_NAME=ims
REDIS_URL=redis://localhost:6379

SESSION_COOKIE_NAME=ims.sid
SESSION_SECRET=change-me-to-a-random-64-char-value-before-first-run-xxxxxxxxxx
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
CSRF_SECRET=change-me-to-a-random-64-char-value-before-first-run-xxxxxxxxxxx

PASSWORD_PEPPER=change-me-to-a-random-64-char-value-before-first-run-xxxxxxx
MFA_ENCRYPTION_KEY=change-me-to-a-random-64-char-value-before-first-run-xxxxxx

# Read only by `pnpm db:seed` (apps/api/src/seed.ts), never by the running API.
# Local dev convenience only -- if SEED_ADMIN_PASSWORD is unset, the seed
# script generates a random password and prints it once to the console
# instead (it is not stored anywhere, so if you miss it, use the
# forgot-password flow to issue yourself a new one). Do not set a real
# password here in a committed/shared env file.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_PASSWORD=

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=ims-private
OBJECT_STORAGE_ACCESS_KEY=localminio
OBJECT_STORAGE_SECRET_KEY=localminiosecret

# Real SMTP relay (nodemailer, in apps/worker) -- no local mail-catcher is
# used. Leave MAIL_HOST unset to disable outbound email entirely; the
# worker logs a warning and skips the send instead of failing. In that
# case (or any time you don't want to wait on real email while testing),
# note that the API's forgot-password and create-user responses already
# include the raw reset/invite token directly in the JSON body whenever
# NODE_ENV != production -- use that token with the browser's
# /reset-password?token=... page instead of relying on email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=inventory@example.test

LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEFAULT_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DEFAULT_EXPIRY_WARNING_DAYS=90
