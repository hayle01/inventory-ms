{
  "name": "inventory-ms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm -r --if-present run test:integration",
    "test:security": "pnpm -r --if-present run test:security",
    "test:e2e": "pnpm -r --if-present run test:e2e",
    "db:migrate": "pnpm --filter @inventory-ms/api run db:migrate",
    "db:verify-indexes": "pnpm --filter @inventory-ms/api run db:verify-indexes",
    "dev:api": "pnpm --filter @inventory-ms/api run dev",
    "dev:web": "pnpm --filter @inventory-ms/web run dev",
    "dev:worker": "pnpm --filter @inventory-ms/worker run dev",
    "docker:up": "docker compose -f infra/docker/compose/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
